# Copy to .env and fill in real values. Never commit your real .env.

# ---- App ----
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- MongoDB ----
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
# Optional: comma-separated DNS servers for SRV resolution (e.g. 1.1.1.1,8.8.8.8)
MONGODB_DNS_SERVERS=

# ---- Better Auth ----
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=

# ---- AI (optional; powers welcome + news-summary emails) ----
GEMINI_API_KEY=

# ---- Email (Nodemailer via Gmail app password) ----
NODEMAILER_EMAIL=you@gmail.com
NODEMAILER_PASSWORD=your-gmail-app-password

# ---- Finnhub (market data) ----
# Prefer a server-only key (NOT exposed to the browser):
FINNHUB_API_KEY=your-finnhub-key
# Optional base-URL override:
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ---- Inngest ----
INNGEST_DEV=1

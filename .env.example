# stockMania — environment variables template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER put real keys in this file — it is committed to git.

# App
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/stockmania
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Auth
BETTER_AUTH_SECRET=<generate: openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=<same as BETTER_AUTH_SECRET>

# Email
NODEMAILER_EMAIL=your@gmail.com
NODEMAILER_PASSWORD=your-app-password

# Finnhub market data
FINNHUB_API_KEY=your_finnhub_api_key
NEXT_PUBLIC_FINNHUB_API_KEY=your_finnhub_api_key

# Zerodha (Indian stocks NSE/BSE)
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_REDIRECT_URL=http://localhost:3000/api/zerodha/callback

# Alpaca (US stocks — paper by default)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_LIVE=true

# Gemini AI (optional — graceful degradation)
GEMINI_API_KEY=your_gemini_api_key

# Twilio WhatsApp alerts (optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Redis — Upstash free tier (rediss:// format, NOT https://)
# Get from: upstash.com → your database → "Redis URL" (ioredis compatible)
REDIS_URL=rediss://default:your_password@your-endpoint.upstash.io:6379

# Kafka (optional — Inngest fallback when not set)
# KAFKA_BROKERS=localhost:9092
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Inngest
INNGEST_DEV=1
# INNGEST_SIGNING_KEY=  # production only (Vercel)
# INNGEST_EVENT_KEY=    # production only (Vercel)

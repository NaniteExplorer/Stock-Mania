# Environment template. Copy to .env.local and fill in.
# NEVER commit .env.local. NEVER put real secrets in this file — it is in git.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Database (libSQL) ─────────────────────────────────────────────────────────
# Local: a file on disk. Nothing to install, nothing to run.
DATABASE_URL=file:./data/finance.db

# Hosted on Turso (free tier). Create one with:
#   turso db create finance && turso db show finance --url
#   turso db tokens create finance
# DATABASE_URL=libsql://finance-<you>.turso.io
# DATABASE_AUTH_TOKEN=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Email (optional) ──────────────────────────────────────────────────────────
# Sends verification and password-reset mail. Leave blank in local development —
# sign-up still works and the mail is skipped with a logged `mail.skipped` line.
# (v1 read NODEMAILER_EMAIL/NODEMAILER_PASSWORD and built a transport with
# undefined credentials when they were absent; these are the replacements.)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── Encrypted statement archive (optional) ────────────────────────────────
# Use a durable mounted directory in production. Generate the key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DOCUMENT_STORAGE_DIR=./data/documents
# DOCUMENT_ENCRYPTION_KEY=

# No other keys are needed. Price refresh uses keyless public sources
# (AMFI NAV file, NSE public quotes), so there is nothing to sign up for.

# ── Market data (optional, recommended for production) ───────────────────────────────
# Enables real-time current quotes for USD-denominated US equities and ETFs.
FINNHUB_API_TOKEN=
# At least 16 random characters. Vercel sends this as Bearer auth to cron routes.
CRON_SECRET=

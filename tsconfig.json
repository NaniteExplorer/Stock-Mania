{
  "compilerOptions": {
    // ES2020 or later is required for `bigint` literals (`100n`), which the
    // Money / Quantity / Percentage value objects are built on.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // `src/*` first, repo root second. The root fallback exists only while the
    // v1 tree is being removed; drop it once `features/`, `core/` and `lib/` are
    // gone so a stale import fails loudly instead of silently resolving.
    "paths": {
      "@/*": ["./src/*", "./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `_reference/` is a frozen snapshot of v1 kept for porting only. Excluding it is
  // what stops it re-creating the very type errors deleting v1 removes.
  "exclude": ["node_modules", "_reference"]
}
